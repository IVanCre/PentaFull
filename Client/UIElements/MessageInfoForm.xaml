<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client.UIElements.MessageInfoForm"
             xmlns:models="clr-namespace:Client.Models"
             x:Name="this">


    <Border Padding="10" 
            Margin="2"
            StrokeShape="RoundRectangle 15"
            BackgroundColor="#F0F0F0"
            x:DataType="models:MessageInfo">

        <Grid x:DataType="models:MessageInfo" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*">
            <Label Grid.Row="0"
                   x:Name="SenderLabel"
                   Text="{Binding SenderName}" 
                   FontSize="12" 
                   TextColor="DimGray" 
                   FontAttributes="Bold"/>

            <Label Grid.Row="1"
                   x:Name="TextLabel"
                   Text="{Binding Text}" 
                   FontSize="16" 
                   TextColor="Black"/>

            <Label Grid.Row="2"
                   x:Name="TimestampLabel"
                   Text="{Binding Timestamp}" 
                   FontSize="10" 
                   TextColor="DimGray"/>
        </Grid>
    </Border>
</ContentView>
