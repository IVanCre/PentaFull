<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client.Pages.SettingsPage"
             Title="Настройки">

    <VerticalStackLayout Margin="20" Spacing="15">
        <Grid ColumnDefinitions="*, Auto">
            <Label Text="CurrentVersion" VerticalOptions="Center"/>
            <Label Grid.Column="1" Text="{Binding AppVersion}" FontAttributes="Bold"/>
        </Grid>

        <Grid ColumnDefinitions="*, Auto">
            <Label Text="ServerAvailable" VerticalOptions="Center"/>
            <Label Grid.Column="1" Text="{Binding ServerAvailable}" FontAttributes="Bold"/>
        </Grid>

        <Grid ColumnDefinitions="*, Auto">
            <Label Text="NewVersion" VerticalOptions="Center"/>
            <Button Text="Install" Clicked="DownloadClick" HorizontalOptions="End" />
        </Grid>

    </VerticalStackLayout>
</ContentPage>