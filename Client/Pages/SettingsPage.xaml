<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client.Pages.SettingsPage"
             Title="Настройки">
    
    <VerticalStackLayout>
        <Grid Margin="10" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto, *">
            <Label Grid.Row="0" Grid.Column="0" Text="Version" HorizontalTextAlignment="Start"/>
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" HorizontalTextAlignment="End"/>

            <Label Grid.Row="1" Grid.Column="0" Text="ServerAvailable" HorizontalTextAlignment="Start"/>
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ServerAvailable}" HorizontalTextAlignment="End"/>


            <Button Grid.Row="2" Grid.Column="1" Text="Install" Clicked="DownloadClick" HorizontalOptions="End" Margin="20"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>