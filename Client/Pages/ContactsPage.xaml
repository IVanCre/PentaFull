<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client.Pages.ContactsPage"
             xmlns:local="clr-namespace:Client.UIElements"
             Title="Контакты">

    <VerticalStackLayout>
        <Grid RowDefinitions="*,Auto" VerticalOptions="StartAndExpand">
            <Label Grid.Row="0"
               HorizontalOptions="CenterAndExpand"
               VerticalOptions="End"
               BackgroundColor="{StaticResource Gray100}"
               TextColor="{StaticResource Black}"
               x:Name="MyContactIDLabel"
               Margin="10"/>

            <CollectionView Grid.Row="1" ItemsSource="{Binding ContactsList}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <local:LongButton Text="{Binding UserName}"
                            TextColor="{StaticResource Black}"
                            LongPressClicked="OnLongClick"
                            ShortPressClicked="OnShortClick"
                            HorizontalOptions="Fill"
                            VerticalOptions= "CenterAndExpand"
                            BackgroundColor="{StaticResource Gray100}"
                            BorderColor="{StaticResource PrimaryDark}"
                            BorderWidth="3"
                            Margin="10"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Button 
                Text="AddNewContact" 
                BackgroundColor="{StaticResource Secondary}"
                TextColor="{StaticResource Black}"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="10"
                Clicked="OnContactCreateClick" />
    </VerticalStackLayout>
</ContentPage>