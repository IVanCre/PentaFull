<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client.Pages.ContactsPage"
             Title="Контакты">
    
    <Grid RowDefinitions="*,Auto">
        <Label Grid.Row="0" 
               Text="{Binding MyContactID}"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding ContactsList}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding UserName}"
                            Clicked="OnContactClick"
                            HorizontalOptions="Fill"
                            VerticalOptions="CenterAndExpand"
                            Margin="10"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <Button Grid.Row="2"
                Text="NewContact" 
                HorizontalOptions="Fill"
                VerticalOptions="End"
                Margin="10"
                Clicked="OnContactCreateClick" />
    </Grid>
</ContentPage>