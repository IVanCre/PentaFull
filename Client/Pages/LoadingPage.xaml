<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client.Pages.LoadingPage"
             Title="LoadingPage"
             BackgroundColor="#512BD4" >

    <!-- Используем Grid, чтобы легко центрировать элементы друг над другом -->
    <Grid>
        <VerticalStackLayout 
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            Spacing="20">

            <Image
                Source="splash.png" 
                WidthRequest="128" 
                HeightRequest="128" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>