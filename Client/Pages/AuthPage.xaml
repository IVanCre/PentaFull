<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client.Pages.AuthPage"
             Title="Авторизация"
             BackgroundColor="{StaticResource OffBlack}">

    <StackLayout  
        Spacing="15" 
        VerticalOptions="StartAndExpand" 
        BackgroundColor ="{StaticResource OffBlack}">

        <Entry x:Name="Address" 
               Placeholder="Адрес сервера"
               TextColor="{StaticResource White}"
               PlaceholderColor="{StaticResource PrimaryDark}"
               HorizontalTextAlignment="Center"
               Margin="0,20,0,0"/>
        
        <Entry x:Name="Port"
               Placeholder="Порт сервера"
               TextColor="{StaticResource White}"
               PlaceholderColor="{StaticResource PrimaryDark}"
               HorizontalTextAlignment="Center"/>

        <Entry x:Name="UsernameEntry"
               MaxLength="50"
               TextColor="{StaticResource White}"
               PlaceholderColor="{StaticResource PrimaryDark}"
               HorizontalTextAlignment="Center"
               Placeholder="Логин"
               Keyboard="Default" 
               Margin="20"/>

        <Entry x:Name="PasswordEntry"
               MaxLength="50"
               TextColor="{StaticResource White}"
               HorizontalTextAlignment="Center"
               PlaceholderColor="{StaticResource PrimaryDark}"
               Placeholder="Пароль"
               IsPassword="True"
               Keyboard="Default" />

        <Button x:Name="RegButton"
                Margin="5"
                Text="Зарегистрироваться"
                TextColor="{StaticResource White}"
                Clicked="OnRegButtonClicked" />

        <Button x:Name="LoginButton"
                Margin="5"
                Text="Вход"
                TextColor="{StaticResource White}"
                Clicked="OnLoginButtonClicked" />

        <ActivityIndicator 
            x:Name="LoaderSpin"
            IsRunning="False" 
            Color="MediumPurple"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />


    </StackLayout>
</ContentPage>