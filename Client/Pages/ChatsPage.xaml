<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client.Pages.ChatsPage"
             Title="Чаты">

    <VerticalStackLayout>
        <Grid RowDefinitions="*,Auto" VerticalOptions="StartAndExpand">
            <CollectionView Grid.Row="0" ItemsSource="{Binding ChatsList}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button Text="{Binding ChatName}"
                            TextColor="{StaticResource White}"
                            Clicked="OnChatClick"
                            HorizontalOptions="Fill"
                            VerticalOptions="CenterAndExpand"
                            Margin="10"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Button Text="Новый групповой чат"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="{StaticResource Black}"
                HorizontalOptions="Fill"
                VerticalOptions="End"
                Margin="10"
                Clicked="OnStartNewClick" />
    </VerticalStackLayout>
</ContentPage>