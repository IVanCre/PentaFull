<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Client.Pages.ChatsPage"
             xmlns:localUI="clr-namespace:Client.UIElements"

             Title="Чаты">


    <Grid RowDefinitions="Auto, *, Auto">

        <CollectionView 
                Grid.Row="0" 
                ItemsSource="{Binding ChatsList}"
                VerticalScrollBarVisibility="Always">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid  ColumnDefinitions="Auto, *,Auto" RowDefinitions="Auto" Margin="5">
                        <Image  
                            Grid.Column="0" 
                            Source="{Binding ImageSourceName}"
                            HorizontalOptions="Start"/>

                        <localUI:LongButton
                            Grid.Column="1"
                            Text="{Binding ChatName}"
                            TextColor="{StaticResource Black}"
                            BackgroundColor="{StaticResource White}"
                            LongPressClicked="OnLongClick"
                            ShortPressClicked="OnShortClick"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            BorderColor="{StaticResource PrimaryDark}"
                            BorderWidth="3"
                            Margin="5"/>

                        <Image 
                            Grid.Column="2" 
                            HorizontalOptions="End"
                            IsVisible="{Binding HaveUnreadedMessages}"
                            Source="{Binding NotifySourceName}"/>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button 
            Grid.Row="1"
            Text="Создать чат"
            TextColor="{StaticResource White}"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="End"
            Margin="10"
            Clicked="OnCreateNew" />

        <ActivityIndicator 
            x:Name="LoaderSpin"
            IsRunning="False" 
            Color="MediumPurple"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </Grid>
</ContentPage>